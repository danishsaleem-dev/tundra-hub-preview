# Local dev MUST point at the development Neon branch, never at production.
# Get these two from the Neon Console: Branches -> development -> Connect.
# DATABASE_URL is the pooled connection (used at runtime); DIRECT_URL is the
# unpooled one (used by `prisma migrate`/`prisma db seed`).
DATABASE_URL="postgresql://<user>:<password>@<development-branch-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<development-branch-host>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Dev Clerk instance — paired with the development branch above, separate
# from the production Clerk instance the deployed app uses.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
